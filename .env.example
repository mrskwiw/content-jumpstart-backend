# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Web Search (at least one required for research tools) ─────────────────────
# Tavily — https://tavily.com
TAVILY_API_KEY=

# Brave Search — https://brave.com/search/api/
BRAVE_API_KEY=

# SerpAPI — https://serpapi.com
SERPAPI_API_KEY=

# ── DataForSEO (optional — Google Trends fallback, ~$0.002/keyword) ───────────
# Sign up at https://dataforseo.com, copy Login + Password from your dashboard
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
# Production requires PostgreSQL. Supabase: use the IPv4 Transaction Pooler host
# (aws-<n>-<region>.pooler.supabase.com:6543) with username postgres.<project-ref>.
# e.g. postgresql://postgres.<ref>:<pw>@aws-1-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Leave unset for local dev to use a local SQLite file.
DATABASE_URL=
# DEV ONLY: allow a silent fallback to ephemeral in-memory SQLite when the
# Postgres connection fails. Keep false in production so a bad DATABASE_URL
# fails loudly at startup instead of quietly running on a throwaway database.
ALLOW_SQLITE_FALLBACK=false

# ── Admin seeding (first boot only, when the users table is empty) ────────────
# Seeded as superusers on first startup. Use a strong DEFAULT_USER_PASSWORD.
PRIMARY_ADMIN_EMAIL=
SECONDARY_ADMIN_EMAIL=
DEFAULT_USER_PASSWORD=
# Set true once to re-seed/reset admin accounts even if users already exist,
# then set it back to false.
FORCE_ADMIN_SEED=false

# ── Optional integrations ─────────────────────────────────────────────────────
# U.S. Census Bureau (free) — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
