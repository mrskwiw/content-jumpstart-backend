# =============================================================================
# 30-Day Content Jumpstart — environment variables (template)
#
#   cp .env.example .env    # then fill in values
#
# Every variable the backend/app reads is listed here (keys only, no values).
# KEEP THIS FILE IN SYNC: when you add/rename/remove an env var in code, update
# this file in the same commit. See project/CLAUDE.md → "Environment variables".
#
# Legend:  [REQUIRED] must be set to run   ·   others are optional / have defaults
# Secrets have NO default — never commit real values (.env is gitignored).
# =============================================================================


# ── Core (required) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # [REQUIRED] Claude API key (content generation)
ANTHROPIC_MODEL=              # default: claude-sonnet-4-5-20250929
SECRET_KEY=                   # [REQUIRED] JWT signing key (no default; generate a strong random value)

# ── Database ──────────────────────────────────────────────────────────────────
# Production requires PostgreSQL. Supabase: IPv4 Transaction Pooler host
# (aws-<n>-<region>.pooler.supabase.com:6543), user postgres.<project-ref>:
#   postgresql://postgres.<ref>:<pw>@aws-1-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Leave unset for local dev (falls back to a local SQLite file).
DATABASE_URL=
ALLOW_SQLITE_FALLBACK=        # default: false — DEV ONLY. Keep false in prod so a bad DB URL fails loudly.

# ── Auth & admin seeding (first boot only, when users table is empty) ─────────
PRIMARY_ADMIN_EMAIL=
PRIMARY_ADMIN_NAME=
SECONDARY_ADMIN_EMAIL=
SECONDARY_ADMIN_NAME=
DEFAULT_USER_PASSWORD=        # strong password for the seeded admin accounts
FORCE_ADMIN_SEED=             # default: false — set true once to re-seed even if users exist, then revert
SUPER_ADMIN_EMAILS=           # comma-separated emails always treated as superusers
ENFORCE_RESOURCE_OWNERSHIP=   # default: false — extra per-resource ownership checks
ACCESS_TOKEN_EXPIRE_MINUTES=  # default: 480
REFRESH_TOKEN_EXPIRE_DAYS=    # default: 7
ALGORITHM=                    # default: HS256

# ── Encryption / secrets management ───────────────────────────────────────────
SETTINGS_ENCRYPTION_KEY=      # [REQUIRED outside DEBUG_MODE] Fernet key encrypting stored OAuth tokens
SECRETS_PROVIDER=             # optional secrets backend selector (default: env)

# ── Web search (research tools — at least one recommended) ────────────────────
WEB_SEARCH_PROVIDER=          # tavily | brave | serpapi (auto-detects from keys if unset)
TAVILY_API_KEY=               # https://tavily.com
BRAVE_API_KEY=                # https://brave.com/search/api/
SERPAPI_API_KEY=              # https://serpapi.com

# ── Optional research integrations ────────────────────────────────────────────
CENSUS_API_KEY=               # U.S. Census (free) https://api.census.gov/data/key_signup.html
DATAFORSEO_LOGIN=             # Google Trends fallback https://dataforseo.com
DATAFORSEO_PASSWORD=

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ── Phase 10: Distribution (multi-platform publishing) ────────────────────────
DISTRIBUTION_DRY_RUN=         # default: false — route all publishes to the no-network stub
RUN_SCHEDULER=                # default: false — run the in-process publish/media scheduler
SCHEDULER_INTERVAL_SECONDS=   # default: 60 — distribution scheduler tick
OAUTH_REDIRECT_BASE_URL=      # frontend base URL the OAuth callback bounces back to
# Per-platform OAuth app credentials (only for platforms you connect):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=              # used by both Facebook AND Instagram
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Phase 11: Analytics & engagement ──────────────────────────────────────────
ANALYTICS_DRY_RUN=            # default: false — use stub metric collectors (demos/tests)

# ── Phase 12: Media generation (audio + video) ────────────────────────────────
MEDIA_DRY_RUN=                # default: false — route every media provider to the no-spend stub
MEDIA_STORAGE_BACKEND=        # default: supabase (| stub) — durable asset store
MEDIA_STORAGE_BUCKET=         # default: media — Supabase Storage bucket (must exist, private)
MEDIA_WEBHOOK_SECRET=         # HMAC secret verifying async provider callbacks
MEDIA_MAX_JOB_COST_CENTS=     # default: 0 (disabled) — per-job spend ceiling
MEDIA_MAX_MONTHLY_COST_CENTS= # default: 0 (disabled) — per-user/month spend ceiling
MEDIA_SCHEDULER_INTERVAL_SECONDS=  # default: 60 — media poll worker tick (needs RUN_SCHEDULER=true)
FFMPEG_PATH=                  # default: ffmpeg — path to the ffmpeg binary (cinematic assembly)
AUDIO_LUFS_DEFAULT=           # default: -14 — target loudness for Auphonic mastering
# Asset storage (Supabase Storage) — also used as the app DB host:
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=         # Supabase service-role key (uploads + signed URLs)
# Provider API keys (set only the ones you use; unset = fail-closed):
ELEVENLABS_API_KEY=           # TTS, voice isolator, dubbing (shared)
ELEVENLABS_VOICE_ID=          # default voice for TTS
AUPHONIC_API_KEY=             # loudness mastering
HEYGEN_API_KEY=               # talking-head avatar video
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
KLING_API_KEY=                # generative b-roll clips (cinematic default)
SYNC_API_KEY=                 # Sync.so lip-sync (optional)
GOOGLE_VERTEX_PROJECT=        # Veo premium clips (Vertex AI) — gated until access confirmed
GOOGLE_VERTEX_ACCESS_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=                    # default: INFO
LOG_FORMAT=                   # default: standard | json
SENTRY_DSN=                   # optional error reporting
DEBUG_MODE=                   # default: true (dev). MUST be false in production.

# ── Runtime / platform (usually set by the host, not by you) ──────────────────
ENVIRONMENT=                  # e.g. production | development
ENV_FILE=                     # default: .env — alternate dotenv path to load
# TESTING / RENDER are auto-set by pytest / Render; do not set manually.

# ── Advanced tuning (optional — sensible defaults in backend/config.py) ───────
CORS_ORIGINS=                 # comma-separated allowed origins
API_HOST=                     # default: 0.0.0.0
API_PORT=                     # default: 8000
PARALLEL_GENERATION=          # default: true
MAX_CONCURRENT_API_CALLS=     # default: 10 — reduce if hitting Anthropic rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=   # default: 2800
RATE_LIMIT_TOKENS_PER_MINUTE=     # default: 280000
RATE_LIMIT_STORAGE=               # slowapi storage URI (default: in-memory)
STARTING_CREDITS=             # default: 1000 — credits for new prod accounts
DEBUG_CREDITS=                # default: 100000 — credits for new dev accounts
MAX_UPLOAD_SIZE_MB=           # default: 10
ALLOWED_BRIEF_EXTENSIONS=     # default: .txt,.md,.docx
TEMPLATE_LIBRARY_PATH=        # default: 02_POST_TEMPLATE_LIBRARY.md
# DB connection pool:
DB_POOL_SIZE=                 # default: 20
DB_MAX_OVERFLOW=              # default: 40
DB_POOL_RECYCLE=
DB_POOL_TIMEOUT=
DB_POOL_PRE_PING=             # default: true
DB_ECHO_POOL=                 # default: false
# Cache TTL / size (seconds / entries):
CACHE_TTL_SHORT=
CACHE_TTL_MEDIUM=
CACHE_TTL_LONG=
CACHE_MAX_SIZE_SHORT=
CACHE_MAX_SIZE_MEDIUM=
CACHE_MAX_SIZE_LONG=
# Celery / Redis (background tasks, if enabled):
REDIS_URL=                    # default: redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Generation pipeline tuning (src/config/settings.py — rarely overridden) ───
# The CLI/agent pipeline exposes many BaseSettings knobs as env vars; the notable
# ones are below. The rest (temperatures, word-count bounds, cache flags,
# template paths) keep their defaults in src/config/settings.py — override by name.
DEFAULT_POST_COUNT=           # default: 30 — posts generated per run
DEFAULT_TEMPLATE_COUNT=       # default: 15
DEFAULT_OUTPUT_FORMAT=        # default: txt
TEMPERATURE=                  # default: 0.7 — generation creativity
MAX_TOKENS=                   # default: 4096
TIMEOUT_SECONDS=              # default: 120 — per Anthropic call
LOG_FILE=                     # default: logs/content_jumpstart.log
ENABLE_RESPONSE_CACHE=        # default: false — disk cache of API responses
ENABLE_PROMPT_CACHING=        # default: true — Anthropic prompt caching

# =============================================================================
# Frontend (operator-dashboard) — build-time vars live in operator-dashboard/.env
#   VITE_API_URL       backend base URL
#   VITE_DEBUG_MODE    verbose client logging
#   VITE_USE_MOCKS     use MSW mock API
#
# Platform provisioning (root ../provision_customer.py, NOT the app): RENDER_API_KEY,
# Supabase/Render/Stripe platform keys live in ../platform-config.json (gitignored),
# not in this .env. See project/CLAUDE.md → "Deployment model".
# =============================================================================
