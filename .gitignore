# Testing — test SOURCES are now committed (CI restructure Phase 5) so CI can run
# them. Only ARTIFACTS are ignored below. Do NOT re-add tests/, backend/tests/,
# *.test.tsx, etc. — that hides the suite from CI (the whole point of the restructure).
# pre-existing untracked project/tests set, kept for later triage
tests_legacy_backup/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
coverage/
operator-dashboard/coverage/
.tox/
coverage*.json
test_*.txt
*_test.py
# generated e2e run output (client_info/articles/*.json)
tests/results/
# ...but committed test fixtures/assets under tests/ are NOT artifacts — keep them.
!tests/**/*.txt

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime Data (ALL client-related data is gitignored)
data/
!data/.gitkeep
!data/briefs/.gitkeep
!data/outputs/.gitkeep
!data/projects/.gitkeep

# Logs
*.log
logs/
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

